                    <munit-tools:payload value="#[output application/java --- [{customer_id: 'CUS-2026-222222', tenant_id: 'TNT-ACME-0001', company_name: 'Acme Test Pvt Ltd', plan_code: 'GROWTH_ANNUAL', seats: 25, region: 'IN', email: 'pending.user@example.com'}]]" mediaType="application/java"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="db:update">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[{affectedRows: 1}]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="vm:publish">
                <munit-tools:then-return>
                    <munit-tools:payload value="#['published']"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:attributes value="#[{queryParams: {token: 'valid-token-123'}}]"/>
            </munit:set-event>
            <flow-ref name="get:\customers\verify:customer-onboarding-config"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(200)]" message="Expected HTTP 200"/>
            <munit-tools:assert-that expression="#[payload.accountStatus]" is="#[MunitTools::equalTo('ACTIVE')]" message="Expected ACTIVE"/>
            <munit-tools:assert-that expression="#[payload.customerId]" is="#[MunitTools::equalTo('CUS-2026-222222')]" message="Expected the customer ID"/>
            <munit-tools:verify-call processor="db:update" times="3"/>
            <munit-tools:verify-call processor="vm:publish" times="1"/>
        </munit:validation>
    </munit:test>

