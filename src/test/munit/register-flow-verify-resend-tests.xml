    <munit:test name="verify-missing-token-returns-400" description="A missing token is rejected before any database work">
        <munit:behavior>
            <munit-tools:mock-when processor="db:update">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[{affectedRows: 1}]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:attributes value="#[{queryParams: {}}]"/>
            </munit:set-event>
            <flow-ref name="get:\customers\verify:customer-onboarding-config"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(400)]" message="Expected HTTP 400"/>
            <munit-tools:assert-that expression="#[payload.code]" is="#[MunitTools::equalTo('TOKEN_MISSING')]" message="Expected TOKEN_MISSING"/>
            <munit-tools:verify-call processor="db:select" times="0"/>
            <munit-tools:verify-call processor="db:update" times="0"/>
        </munit:validation>
    </munit:test>

