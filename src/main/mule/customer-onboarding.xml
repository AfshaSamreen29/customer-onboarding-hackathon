<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit" xmlns:db="http://www.mulesoft.org/schema/mule/db" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:email="http://www.mulesoft.org/schema/mule/email" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:vm="http://www.mulesoft.org/schema/mule/vm" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd  http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd http://www.mulesoft.org/schema/mule/email http://www.mulesoft.org/schema/mule/email/current/mule-email.xsd http://www.mulesoft.org/schema/mule/vm http://www.mulesoft.org/schema/mule/vm/current/mule-vm.xsd">
    <http:listener-config name="customer-onboarding-httpListenerConfig">
        <http:listener-connection host="0.0.0.0" port="8081" />
    </http:listener-config>
    <apikit:config name="customer-onboarding-config" api="customer-onboarding.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
    <configuration-properties doc:name="Configuration properties" doc:id="fb0049d4-f860-4c1a-9dae-5cab2840c1ad" file="config.properties" />
    <db:config name="Database_Config" doc:name="Database Config" doc:id="d102819a-b563-46af-a8c5-2f3d85a50509">
        <db:my-sql-connection host="${db.host}" port="${db.port}" user="${db.user}" password="${db.password}" database="${db.name}" />
    </db:config>
    <email:smtp-config name="SMTP_Config" doc:name="Email SMTP Config">
        <email:smtp-connection host="${smtp.host}" port="${smtp.port}" user="${smtp.user}" password="${smtp.password}" />
    </email:smtp-config>
    <vm:config name="VM_Config" doc:name="VM Config">
        <vm:queues>
            <vm:queue queueName="provisioningQueue" queueType="PERSISTENT" />
            <vm:queue queueName="activationQueue" queueType="PERSISTENT" />
        </vm:queues>
    </vm:config>
    <flow name="customer-onboarding-main">
        <http:listener config-ref="customer-onboarding-httpListenerConfig" path="/api/v1/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="customer-onboarding-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:BAD_REQUEST">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Bad request"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">400</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Method not allowed"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">405</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_ACCEPTABLE">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not acceptable"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">406</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:UNSUPPORTED_MEDIA_TYPE">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Unsupported media type"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">415</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_IMPLEMENTED">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not Implemented"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">501</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="customer-onboarding-console">
        <http:listener config-ref="customer-onboarding-httpListenerConfig" path="/console/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="customer-onboarding-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="provisioning-consumer-simulator">
        <vm:listener config-ref="VM_Config" queueName="provisioningQueue" doc:name="Listen on provisioning queue"/>
        <logger level="INFO" message='#["[SIMULATED PROVISIONING] Event received: " ++ payload.eventType ++ ", correlationId=" ++ payload.correlationId]' doc:name="Log event received"/>
        <logger level="INFO" message='#["[SIMULATED PROVISIONING] Creating workspace for tenant " ++ payload.payload.tenantId ++ " in region " ++ payload.payload.region ++ " (data residency " ++ payload.payload.dataResidency ++ ")"]' doc:name="Simulate workspace creation"/>
        <logger level="INFO" message='#["[SIMULATED PROVISIONING] Seeding default data for tenant " ++ payload.payload.tenantId]' doc:name="Simulate default data seeding"/>
        <logger level="INFO" message='#["[SIMULATED PROVISIONING] Applying licence limits: seats=" ++ (payload.payload.seats as String) ++ ", entitlements=" ++ (payload.payload.entitlements joinBy ",")]' doc:name="Simulate licence limits"/>
    </flow>
    <flow name="activation-consumer-simulator">
        <vm:listener config-ref="VM_Config" queueName="activationQueue" doc:name="Listen on activation queue"/>
        <logger level="INFO" message='#["[SIMULATED ACTIVATION] Event received: " ++ payload.eventType ++ ", correlationId=" ++ payload.correlationId]' doc:name="Log activation event received"/>
        <logger level="INFO" message='#["[SIMULATED ACTIVATION] Marking workspace ready for tenant " ++ payload.payload.tenantId ++ ", plan " ++ payload.payload.planCode]' doc:name="Simulate workspace ready"/>
    </flow>
    <sub-flow name="build-verification-error">
        <ee:transform doc:name="Build verification error response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  code: vars.errCode,
  message: vars.errMessage,
  (resendPath: "/api/v1/customers/resend-verification") if (vars.errCode == "TOKEN_EXPIRED"),
  correlationId: vars.correlationId
}]]></ee:set-payload>
            </ee:message>
            <ee:variables>
                <ee:set-variable variableName="httpStatus">400</ee:set-variable>
            </ee:variables>
        </ee:transform>
    </sub-flow>
    <flow name="get:\customers\verify:customer-onboarding-config">
        <set-variable variableName="correlationId" value="#[correlationId]" doc:name="Set correlationId"/>
        <logger level="INFO" message='#["Verification request received, correlationId=" ++ vars.correlationId]' doc:name="Log verification request"/>
        <set-variable variableName="tokenParam" value="#[attributes.queryParams.token default '']" doc:name="Read token (never logged)"/>
        <choice doc:name="Token supplied?">
            <when expression="#[isEmpty(vars.tokenParam)]">
                <set-variable variableName="errCode" value="TOKEN_MISSING" doc:name="Code TOKEN_MISSING"/>
                <set-variable variableName="errMessage" value="A verification token is required." doc:name="Message"/>
                <flow-ref name="build-verification-error" doc:name="Build error"/>
            </when>
            <otherwise>
                <ee:transform doc:name="Hash token">
                    <ee:message/>
                    <ee:variables>
                        <ee:set-variable variableName="tokenHash"><![CDATA[%dw 2.0
import dw::Crypto
import toHex from dw::core::Binaries
output application/java
---
toHex(Crypto::hashWith(vars.tokenParam as Binary, "SHA-256"))]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
                <db:select config-ref="Database_Config" target="tokenRow" doc:name="Find token by hash">
                    <db:sql><![CDATA[SELECT t.customer_id, t.consumed_at, CASE WHEN t.expires_at <= NOW() THEN 1 ELSE 0 END AS is_expired, c.account_status FROM verification_tokens t JOIN customers c ON c.customer_id = t.customer_id WHERE t.token_hash = :tokenHash]]></db:sql>
                    <db:input-parameters><![CDATA[#[{ tokenHash: vars.tokenHash }]]]></db:input-parameters>
                </db:select>
                <choice doc:name="Token state">
                    <when expression="#[sizeOf(vars.tokenRow) == 0]">
                        <logger level="WARN" message='#["Verification rejected: unknown token, correlationId=" ++ vars.correlationId]' doc:name="Log unknown"/>
                        <set-variable variableName="errCode" value="TOKEN_INVALID" doc:name="Code TOKEN_INVALID"/>
                        <set-variable variableName="errMessage" value="This verification link is not valid." doc:name="Message"/>
                        <flow-ref name="build-verification-error" doc:name="Build error"/>
                    </when>
                    <when expression="#[vars.tokenRow[0].consumed_at != null]">
                        <logger level="WARN" message='#["Verification rejected: token already used, correlationId=" ++ vars.correlationId]' doc:name="Log reused"/>
                        <set-variable variableName="errCode" value="TOKEN_ALREADY_USED" doc:name="Code TOKEN_ALREADY_USED"/>
                        <set-variable variableName="errMessage" value="This verification link has already been used." doc:name="Message"/>
                        <flow-ref name="build-verification-error" doc:name="Build error"/>
                    </when>
                    <when expression="#[(vars.tokenRow[0].is_expired as Number) == 1]">
                        <logger level="WARN" message='#["Verification rejected: token expired, correlationId=" ++ vars.correlationId]' doc:name="Log expired"/>
                        <set-variable variableName="errCode" value="TOKEN_EXPIRED" doc:name="Code TOKEN_EXPIRED"/>
                        <set-variable variableName="errMessage" value="This verification link has expired. Please request a new one." doc:name="Message"/>
                        <flow-ref name="build-verification-error" doc:name="Build error"/>
                    </when>
                    <when expression="#[vars.tokenRow[0].account_status != 'PENDING_VERIFICATION']">
                        <logger level="WARN" message='#["Verification rejected: account not pending, correlationId=" ++ vars.correlationId]' doc:name="Log not pending"/>
                        <set-variable variableName="errCode" value="ACCOUNT_NOT_PENDING" doc:name="Code ACCOUNT_NOT_PENDING"/>
                        <set-variable variableName="errMessage" value="This account cannot be verified. Please contact support." doc:name="Message"/>
                        <flow-ref name="build-verification-error" doc:name="Build error"/>
                    </when>
                    <otherwise>
                        <set-variable variableName="activated" value="#[false]" doc:name="Assume not activated"/>
                        <try doc:name="Consume token and activate (one transaction)" transactionalAction="ALWAYS_BEGIN" transactionType="LOCAL">
                            <db:update config-ref="Database_Config" target="consumeResult" doc:name="Consume token once">
                                <db:sql><![CDATA[UPDATE verification_tokens SET consumed_at = NOW(), attempts = attempts + 1 WHERE token_hash = :tokenHash AND consumed_at IS NULL AND expires_at > NOW()]]></db:sql>
                                <db:input-parameters><![CDATA[#[{ tokenHash: vars.tokenHash }]]]></db:input-parameters>
                            </db:update>
                            <choice doc:name="Token consumed by this request?">
                                <when expression="#[vars.consumeResult.affectedRows == 1]">
                                    <db:update config-ref="Database_Config" target="customerUpdate" doc:name="Activate customer">
                                        <db:sql><![CDATA[UPDATE customers SET account_status = 'ACTIVE', updated_at = NOW() WHERE customer_id = :customerId]]></db:sql>
                                        <db:input-parameters><![CDATA[#[{ customerId: vars.tokenRow[0].customer_id }]]]></db:input-parameters>
                                    </db:update>
                                    <db:update config-ref="Database_Config" target="userUpdate" doc:name="Activate user">
                                        <db:sql><![CDATA[UPDATE customer_users SET user_status = 'ACTIVE' WHERE customer_id = :customerId]]></db:sql>
                                        <db:input-parameters><![CDATA[#[{ customerId: vars.tokenRow[0].customer_id }]]]></db:input-parameters>
                                    </db:update>
                                    <set-variable variableName="activated" value="#[true]" doc:name="Activated"/>
                                </when>
                            </choice>
                        </try>
                        <choice doc:name="Activated?">
                            <when expression="#[vars.activated]">
                                <logger level="INFO" message='#["Account activated, customerId=" ++ vars.tokenRow[0].customer_id ++ ", correlationId=" ++ vars.correlationId]' doc:name="Log activated"/>
                                <db:select config-ref="Database_Config" target="customerRow" doc:name="Load customer for event">
                                    <db:sql><![CDATA[SELECT c.customer_id, c.tenant_id, c.company_name, c.plan_code, c.seats, c.region, u.email FROM customers c JOIN customer_users u ON u.customer_id = c.customer_id WHERE c.customer_id = :customerId]]></db:sql>
                                    <db:input-parameters><![CDATA[#[{ customerId: vars.tokenRow[0].customer_id }]]]></db:input-parameters>
                                </db:select>
                                <ee:transform doc:name="Build activation event">
                                    <ee:message/>
                                    <ee:variables>
                                        <ee:set-variable variableName="activationEvent" resource="dwl/activationEvent.dwl"/>
                                    </ee:variables>
                                </ee:transform>
                                <try doc:name="Publish activation event">
                                    <until-successful maxRetries="3" millisBetweenRetries="1000" doc:name="Retry publish">
                                        <vm:publish config-ref="VM_Config" queueName="activationQueue" doc:name="Publish ACCOUNT_ACTIVATED">
                                            <vm:content><![CDATA[#[vars.activationEvent]]]></vm:content>
                                        </vm:publish>
                                    </until-successful>
                                    <logger level="INFO" message='#["Activation event published, customerId=" ++ vars.customerRow[0].customer_id ++ ", correlationId=" ++ vars.correlationId]' doc:name="Log activation event published"/>
                                    <error-handler>
                                        <on-error-continue>
                                            <logger level="ERROR" message='#["ALERT: ACTIVATION_EVENT_FAILED, customerId=" ++ vars.customerRow[0].customer_id ++ ", correlationId=" ++ vars.correlationId]' doc:name="Internal alert"/>
                                        </on-error-continue>
                                    </error-handler>
                                </try>
                                <ee:transform doc:name="Build 200 response">
                                    <ee:message>
                                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  customerId: vars.customerRow[0].customer_id,
  tenantId: vars.customerRow[0].tenant_id,
  accountStatus: "ACTIVE",
  message: "Email verified. Your account is now active.",
  correlationId: vars.correlationId
}]]></ee:set-payload>
                                    </ee:message>
                                    <ee:variables>
                                        <ee:set-variable variableName="httpStatus">200</ee:set-variable>
                                    </ee:variables>
                                </ee:transform>
                            </when>
                            <otherwise>
                                <set-variable variableName="errCode" value="TOKEN_ALREADY_USED" doc:name="Code TOKEN_ALREADY_USED"/>
                                <set-variable variableName="errMessage" value="This verification link has already been used." doc:name="Message"/>
                                <flow-ref name="build-verification-error" doc:name="Build error"/>
                            </otherwise>
                        </choice>
                    </otherwise>
                </choice>
            </otherwise>
        </choice>
    </flow>
    <flow name="post:\customers\register:application\json:customer-onboarding-config">
        <set-variable variableName="correlationId" value="#[correlationId]" doc:name="Set correlationId"/>
        <logger level="INFO" message='#["Registration request received, correlationId=" ++ vars.correlationId]' doc:name="Log request received"/>
        <ee:transform doc:name="Validate fields">
            <ee:message/>
            <ee:variables>
                <ee:set-variable variableName="validationErrors" resource="dwl/validateRegistration.dwl"/>
            </ee:variables>
        </ee:transform>
        <choice doc:name="Any validation errors?">
            <when expression="#[sizeOf(vars.validationErrors) > 0]">
                <ee:transform doc:name="Build 400 response">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  code: "VALIDATION_ERROR",
  message: "One or more fields are invalid",
  correlationId: vars.correlationId,
  errors: vars.validationErrors
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">400</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </when>
            <otherwise>
                <ee:transform doc:name="Generate IDs and token">
                    <ee:message/>
                    <ee:variables>
                        <ee:set-variable variableName="ids"><![CDATA[%dw 2.0
import dw::Crypto
import toHex from dw::core::Binaries
output application/java
var cleanName = upper(payload.company.companyName replace /[^A-Za-z0-9]/ with "")
var prefix = if (sizeOf(cleanName) > 8) cleanName[0 to 7] else cleanName
var rawToken = (uuid() ++ uuid()) replace /-/ with ""
---
{
  customerId: "CUS-" ++ (now().year as String) ++ "-" ++ ((floor(random() * 900000) + 100000) as String),
  tenantId: "TNT-" ++ prefix ++ "-" ++ upper(uuid()[0 to 3]),
  userId: "USR-" ++ upper(uuid()[0 to 7]),
  token: rawToken,
  tokenHash: toHex(Crypto::hashWith(rawToken as Binary, "SHA-256")),
  expiresAtIso: (now() + |PT24H|) as String {format: "yyyy-MM-dd'T'HH:mm:ssXXX"}
}]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
                <db:select config-ref="Database_Config" target="existingUsers" doc:name="Check duplicate email">
                    <db:sql><![CDATA[SELECT user_id FROM customer_users WHERE email = :email]]></db:sql>
                    <db:input-parameters><![CDATA[#[{ email: lower(payload.primaryContact.email) }]]]></db:input-parameters>
                </db:select>
                <choice doc:name="Email already registered?">
                    <when expression="#[sizeOf(vars.existingUsers) > 0]">
                        <logger level="WARN" message='#["Duplicate registration rejected, correlationId=" ++ vars.correlationId]' doc:name="Log duplicate"/>
                        <ee:transform doc:name="Build 409 response">
                            <ee:message>
                                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  code: "DUPLICATE_EMAIL",
  message: "An account already exists for this email. Please sign in or reset your password.",
  correlationId: vars.correlationId
}]]></ee:set-payload>
                            </ee:message>
                            <ee:variables>
                                <ee:set-variable variableName="httpStatus">409</ee:set-variable>
                            </ee:variables>
                        </ee:transform>
                    </when>
                    <otherwise>
                        <try doc:name="Create account (one transaction)" transactionalAction="ALWAYS_BEGIN" transactionType="LOCAL">
                            <db:insert config-ref="Database_Config" target="insertResult" doc:name="Insert customer">
                                <db:sql><![CDATA[INSERT INTO customers (customer_id, tenant_id, company_name, industry, employee_count, gst_number, address_line1, city, state, postal_code, country, plan_code, seats, billing_currency, region, account_status, marketing_opt_in, terms_accepted_at, correlation_id) VALUES (:customerId, :tenantId, :companyName, :industry, :employeeCount, :gstNumber, :addressLine1, :city, :state, :postalCode, :country, :planCode, :seats, :billingCurrency, :region, :accountStatus, :marketingOptIn, :termsAcceptedAt, :correlationId)]]></db:sql>
                                <db:input-parameters><![CDATA[#[{
  customerId: vars.ids.customerId,
  tenantId: vars.ids.tenantId,
  companyName: payload.company.companyName,
  industry: payload.company.industry,
  employeeCount: payload.company.employeeCount,
  gstNumber: payload.company.gstNumber,
  addressLine1: payload.company.address.addressLine1,
  city: payload.company.address.city,
  state: payload.company.address.state,
  postalCode: payload.company.address.postalCode,
  country: payload.company.address.country,
  planCode: payload.subscription.planCode,
  seats: payload.subscription.seats,
  billingCurrency: payload.subscription.billingCurrency,
  region: payload.subscription.region,
  accountStatus: "PENDING_VERIFICATION",
  marketingOptIn: payload.consent.marketingOptIn default false,
  termsAcceptedAt: (payload.consent.acceptedAt as DateTime) as String {format: "yyyy-MM-dd HH:mm:ss"},
  correlationId: vars.correlationId
}]]]></db:input-parameters>
                            </db:insert>
                            <db:insert config-ref="Database_Config" target="insertResult" doc:name="Insert primary user">
                                <db:sql><![CDATA[INSERT INTO customer_users (user_id, customer_id, email, first_name, last_name, phone, job_title, user_role, user_status) VALUES (:userId, :customerId, :email, :firstName, :lastName, :phone, :jobTitle, :userRole, :userStatus)]]></db:sql>
                                <db:input-parameters><![CDATA[#[{
  userId: vars.ids.userId,
  customerId: vars.ids.customerId,
  email: lower(payload.primaryContact.email),
  firstName: payload.primaryContact.firstName,
  lastName: payload.primaryContact.lastName,
  phone: payload.primaryContact.phone,
  jobTitle: payload.primaryContact.jobTitle,
  userRole: "PRIMARY_ADMIN",
  userStatus: "PENDING"
}]]]></db:input-parameters>
                            </db:insert>
                            <db:insert config-ref="Database_Config" target="insertResult" doc:name="Insert token hash">
                                <db:sql><![CDATA[INSERT INTO verification_tokens (token_hash, customer_id, email, expires_at) VALUES (:tokenHash, :customerId, :email, DATE_ADD(NOW(), INTERVAL 24 HOUR))]]></db:sql>
                                <db:input-parameters><![CDATA[#[{
  tokenHash: vars.ids.tokenHash,
  customerId: vars.ids.customerId,
  email: lower(payload.primaryContact.email)
}]]]></db:input-parameters>
                            </db:insert>
                        </try>
                        <logger level="INFO" message='#["Customer created, customerId=" ++ vars.ids.customerId ++ ", correlationId=" ++ vars.correlationId]' doc:name="Log customer created"/>
                        <ee:transform doc:name="Build email body">
                            <ee:message/>
                            <ee:variables>
                                <ee:set-variable variableName="emailBody" resource="dwl/welcomeEmail.dwl"/>
                            </ee:variables>
                        </ee:transform>
                        <set-variable variableName="emailSent" value="#[false]" doc:name="Assume email not sent"/>
                        <try doc:name="Send welcome email (failure must not fail registration)">
                            <until-successful maxRetries="2" millisBetweenRetries="2000" doc:name="Retry email send">
                                <email:send config-ref="SMTP_Config" fromAddress="no-reply@customer-onboarding.example.com" subject="Welcome to the platform – verify your account" doc:name="Send welcome email">
                                    <email:to-addresses>
                                        <email:to-address value="#[payload.primaryContact.email]"/>
                                    </email:to-addresses>
                                    <email:body contentType="text/plain" encoding="UTF-8">
                                        <email:content><![CDATA[#[vars.emailBody]]]></email:content>
                                    </email:body>
                                </email:send>
                            </until-successful>
                            <set-variable variableName="emailSent" value="#[true]" doc:name="Email sent"/>
                            <db:update config-ref="Database_Config" target="emailStatusResult" doc:name="Mark email SENT">
                                <db:sql><![CDATA[UPDATE customers SET email_status = 'SENT', email_attempts = email_attempts + 1, updated_at = NOW() WHERE customer_id = :customerId]]></db:sql>
                                <db:input-parameters><![CDATA[#[{ customerId: vars.ids.customerId }]]]></db:input-parameters>
                            </db:update>
                            <error-handler>
                                <on-error-continue>
                                    <logger level="WARN" message='#["Welcome email failed after retries, customerId=" ++ vars.ids.customerId ++ ", correlationId=" ++ vars.correlationId]' doc:name="Log email failure"/>
                                    <db:update config-ref="Database_Config" target="emailStatusResult" doc:name="Mark email FAILED">
                                        <db:sql><![CDATA[UPDATE customers SET email_status = 'FAILED', email_attempts = email_attempts + 1, updated_at = NOW() WHERE customer_id = :customerId]]></db:sql>
                                        <db:input-parameters><![CDATA[#[{ customerId: vars.ids.customerId }]]]></db:input-parameters>
                                    </db:update>
                                </on-error-continue>
                            </error-handler>
                        </try>
                        <ee:transform doc:name="Build provisioning event">
                            <ee:message/>
                            <ee:variables>
                                <ee:set-variable variableName="provisioningEvent" resource="dwl/provisioningEvent.dwl"/>
                            </ee:variables>
                        </ee:transform>
                        <set-variable variableName="provisioningOk" value="#[true]" doc:name="Assume provisioning queued"/>
                        <try doc:name="Publish provisioning event (retry, then compensate)">
                            <until-successful maxRetries="3" millisBetweenRetries="1000" doc:name="Retry publish">
                                <vm:publish config-ref="VM_Config" queueName="${queue.publishName}" doc:name="Publish ACCOUNT_SETUP_REQUESTED">
                                    <vm:content><![CDATA[#[vars.provisioningEvent]]]></vm:content>
                                </vm:publish>
                            </until-successful>
                            <logger level="INFO" message='#["Provisioning event published, customerId=" ++ vars.ids.customerId ++ ", correlationId=" ++ vars.correlationId]' doc:name="Log event published"/>
                            <error-handler>
                                <on-error-continue>
                                    <set-variable variableName="provisioningOk" value="#[false]" doc:name="Provisioning failed"/>
                                    <db:update config-ref="Database_Config" target="statusUpdateResult" doc:name="Mark PROVISIONING_FAILED">
                                        <db:sql><![CDATA[UPDATE customers SET account_status = 'PROVISIONING_FAILED', updated_at = NOW() WHERE customer_id = :customerId]]></db:sql>
                                        <db:input-parameters><![CDATA[#[{ customerId: vars.ids.customerId }]]]></db:input-parameters>
                                    </db:update>
                                    <logger level="ERROR" message='#["ALERT: PROVISIONING_FAILED, customerId=" ++ vars.ids.customerId ++ ", tenantId=" ++ vars.ids.tenantId ++ ", correlationId=" ++ vars.correlationId]' doc:name="Internal alert"/>
                                </on-error-continue>
                            </error-handler>
                        </try>
                        <choice doc:name="Provisioning queued?">
                            <when expression="#[vars.provisioningOk]">
                                <ee:transform doc:name="Build 201 response">
                                    <ee:message>
                                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  customerId: vars.ids.customerId,
  tenantId: vars.ids.tenantId,
  accountStatus: "PENDING_VERIFICATION",
  planCode: payload.subscription.planCode,
  seats: payload.subscription.seats,
  verificationEmailSent: vars.emailSent,
  verificationExpiresAt: vars.ids.expiresAtIso,
  correlationId: vars.correlationId
}]]></ee:set-payload>
                                    </ee:message>
                                    <ee:variables>
                                        <ee:set-variable variableName="httpStatus">201</ee:set-variable>
                                    </ee:variables>
                                </ee:transform>
                            </when>
                            <otherwise>
                                <ee:transform doc:name="Build provisioning failure response">
                                    <ee:message>
                                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  code: "PROVISIONING_FAILED",
  message: "Your account was created but workspace setup could not be started. Our team has been notified.",
  correlationId: vars.correlationId
}]]></ee:set-payload>
                                    </ee:message>
                                    <ee:variables>
                                        <ee:set-variable variableName="httpStatus">500</ee:set-variable>
                                    </ee:variables>
                                </ee:transform>
                            </otherwise>
                        </choice>
                    </otherwise>
                </choice>
            </otherwise>
        </choice>
    </flow>
    <flow name="post:\customers\resend-verification:application\json:customer-onboarding-config">
        <logger level="INFO" message="post:\customers\resend-verification:application\json:customer-onboarding-config" />
    </flow>
</mule>